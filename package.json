{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "vite build --config client/vite.config.ts",
    "preview": "vite preview --config client/vite.config.ts",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && eslint client/src server/domain server/application server/infrastructure server/presentation server/index.ts",
    "prisma:generate": "prisma generate --schema=server/infrastructure/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=server/infrastructure/database/prisma/schema.prisma",
    "prisma:seed": "tsx server/infrastructure/database/prisma/seed.ts"
  },
  "prisma": {
    "schema": "server/infrastructure/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.16.0",
    "@reduxjs/toolkit": "^2.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "globals": "^17.14.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "swagger-ui-express": "^5.0.1",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "@types/express": "^4.17.21"
  }
}
