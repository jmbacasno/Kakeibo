{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "../dist-server"
  },
  "include": [
    "domain/**/*",
    "infrastructure/**/*",
    "application/**/*",
    "presentation/**/*",
    "index.ts"
  ]
}
