    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
