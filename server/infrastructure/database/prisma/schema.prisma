generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int           @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String        @unique
  password       String
  lastLoginAt    DateTime?
  loginCount     Int           @default(0)
  failLoginCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  categories     Category[]
  monthlyPlans   MonthlyPlan[]
  settings       UserSettings?
}

model Category {
  id              Int              @id @default(autoincrement())
  userId          Int
  name            String
  description     String?
  type            String           // "INCOME" | "EXPENSE"
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryBudgets CategoryBudget[]
  transactions    Transaction[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

model MonthlyPlan {
  id            Int                @id @default(autoincrement())
  userId        Int
  month         Int                // 1 - 12
  year          Int
  plannedIncome Decimal            @default(0)
  savingsGoal   Decimal            @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets       CategoryBudget[]
  transactions  Transaction[]
  notes         Note[]
  reflection    MonthlyReflection?

  @@unique([userId, month, year])
  @@index([userId, year, month])
}

model CategoryBudget {
  id              Int         @id @default(autoincrement())
  monthlyPlanId   Int
  categoryId      Int
  allocatedAmount Decimal     @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  monthlyPlan     MonthlyPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([monthlyPlanId, categoryId])
  @@index([monthlyPlanId])
  @@index([categoryId])
}

model Transaction {
  id              Int         @id @default(autoincrement())
  monthlyPlanId   Int
  categoryId      Int
  amount          Decimal
  description     String
  transactionDate DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  monthlyPlan     MonthlyPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([monthlyPlanId, transactionDate])
  @@index([categoryId])
}

model Note {
  id            Int         @id @default(autoincrement())
  monthlyPlanId Int
  title         String?
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  monthlyPlan   MonthlyPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@index([monthlyPlanId, createdAt])
}

model MonthlyReflection {
  id            Int         @id @default(autoincrement())
  monthlyPlanId Int         @unique
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  monthlyPlan   MonthlyPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  currency       String   @default("USD")
  language       String   @default("en")
  theme          String   @default("system")
  dateFormat     String   @default("MMM D, YYYY")
  firstDayOfWeek Int      @default(0) // 0 = Sunday, 1 = Monday
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
